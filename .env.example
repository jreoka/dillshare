# S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Optional Custom S3 Endpoint (e.g., Cloudflare R2, MinIO, Wasabi, B2)
# AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Optional Force Path-Style S3 URL addressing (Required by MinIO/LocalStack)
# AWS_S3_FORCE_PATH_STYLE=true

# Presigned URLs are single-operation capabilities and are clamped to 60-900 seconds.
# DILLSHARE_PRESIGN_TTL_SECONDS=300

# Maximum lifetime of one unfinished upload session.
# DILLSHARE_PARTIAL_TIMEOUT_HOURS=12

# Optional Web Server Configuration (Default is 8000)
PORT=8000

# Public application origin. When set, requests with another Host/Origin are rejected.
# Use this exact origin in the private bucket's CORS AllowedOrigins rule, expose ETag
# and Content-Range, and allow GET, HEAD, and PUT for direct transfers.
# URL=https://example.com

# WebAuthn relying-party settings (must match the public application origin).
# RP_ID=example.com
# RP_ORIGIN=https://example.com

# Optional persistent session-signing secret (at least 32 bytes). If omitted, a
# random secret is created atomically in the configured bucket.
# JWT_SECRET=replace-with-at-least-32-random-bytes

# The first registered account is the superadmin. It can promote or demote other
# accounts from the Admin tab; no separate administrator token is used.
