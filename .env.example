# S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Optional Custom S3 Endpoint (e.g., Cloudflare R2, MinIO, Wasabi, B2)
# AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Optional Force Path-Style S3 URL addressing (Required by MinIO/LocalStack)
# AWS_S3_FORCE_PATH_STYLE=true

# Presigned URLs are single-operation capabilities and are clamped to 60-900 seconds.
# DILLSHARE_PRESIGN_TTL_SECONDS=300

# Hard limits for one share and one unfinished upload session.
# DILLSHARE_MAX_SHARE_BYTES=107374182400
# DILLSHARE_PARTIAL_TIMEOUT_HOURS=12
# DILLSHARE_EXPIRE_DAYS=90

# Optional Web Server Configuration (Default is 8000)
PORT=8000

# Optional App URL restriction (rejects requests from other domains/IPs if set)
# Use this exact origin in the private bucket's CORS rule. See S3_DIRECT_TRANSFERS.md.
# URL=https://example.com

# Admin Panel Token configuration
ADMIN_TOKEN=replace-with-a-long-random-secret
